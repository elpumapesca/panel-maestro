<!DOCTYPE html>
<html lang="es">
<head>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧠</text></svg>">
  <meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>ML Panel Pro — Panel Maestro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<!-- v89 [P3]: plugin datalabels para mostrar valores fijos sobre las barras (Facturación) -->
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
<script>
  // v89 [P3]: chartjs-plugin-datalabels se auto-registra globalmente al cargarse,
  // lo que haría que TODOS los charts del panel muestren etiquetas indeseadas.
  // Lo desregistramos para que solo aplique en charts donde lo agreguemos
  // manualmente vía `plugins: [ChartDataLabels]` (chart-fac en Facturación).
  if (typeof Chart !== 'undefined' && typeof ChartDataLabels !== 'undefined') {
    try { Chart.unregister(ChartDataLabels); } catch(e) { /* tolerar */ }
  }
</script>
<style>
:root {
  /* Fondos del Panel Izquierdo (Se mantienen oscuros) */
  --bg:#0b0d12; --bg2:#10131a; --bg3:#161b26; --bg4:#1e2535; --bg5:#252d40;
  --border:rgba(255,255,255,0.06); --border2:rgba(255,255,255,0.11); --border3:rgba(255,255,255,0.18);

  /* COLORES DE TEXTO CORREGIDOS (Para máximo contraste en panel derecho) */
  --text: #0f172a;   /* Negro Azulado (Títulos principales y precios) */
  --text2: #1e293b;  /* Gris muy oscuro (Nombres de productos y textos generales) */
  --text3: #334155;  /* Gris oscuro (Detalles, IDs, SKUs) - Ahora 100% legible */
  --text4: #64748b;  /* Gris medio (Para textos de menor importancia) */

  /* Colores de Acento y Estado */
  --accent:#4f8ef7; --accent2:#82b0ff; --accent-g:rgba(79,142,247,0.12);
  --green:#23d18b; --green-g:rgba(35,209,139,0.1);
  --red:#f4645f; --red-g:rgba(244,100,95,0.1);
  --amber:#f5a623; --amber-g:rgba(245,166,35,0.1);
  --purple:#9d7bea; --purple-g:rgba(157,123,234,0.1);
  --teal:#29d4c5; --teal-g:rgba(41,212,197,0.1);
  --pink:#f472b6; --pink-g:rgba(244,114,182,0.1);
  
  /* Medidas y Fuentes */
  --r:12px; --rs:8px; --rx:16px; --sidebar:248px;
  --font:'DM Sans',sans-serif; --mono:'DM Mono',monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);background:var(--bg);color:var(--text);display:flex;min-height:100vh;overflow-x:hidden}

/* ── SIDEBAR ── */
#sidebar{width:var(--sidebar);background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:100;overflow-y:auto;transition:transform .3s;padding-bottom:100px}
.sb-logo{padding:18px 16px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}
.sb-icon{width:34px;height:34px;background:linear-gradient(135deg,var(--accent),#7c3aed);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:#fff;flex-shrink:0;letter-spacing:-1px}
.sb-title{font-size:14px;font-weight:600;color:var(--text)}
.sb-ver{font-size:10px;color:var(--text3);margin-top:1px}
.sb-store{margin:10px 10px 4px;padding:9px 11px;background:var(--bg3);border-radius:var(--rs);border:1px solid var(--border);cursor:pointer;display:flex;align-items:center;justify-content:space-between}
.sb-store-name{font-size:13px;font-weight:500;color:var(--text)}
.sb-store-sub{font-size:10px;color:var(--text3);margin-top:2px;display:flex;align-items:center;gap:4px}
.online-dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 5px var(--green)}

/* --- ESTILOS DE TEXTO SIDEBAR CORREGIDOS --- */
.sb-sec{padding:14px 14px 3px;font-size:9px;color:#ffffff !important;opacity:1 !important;text-transform:uppercase;letter-spacing:.1em;font-weight:700;text-decoration:underline;text-decoration-color:var(--green)}

.nav{display:flex;align-items:center;gap:8px;padding:7px 12px;margin:1px 6px;border-radius:var(--rs);cursor:pointer;transition:all .14s;font-size:12.5px;color:#ffffff !important;opacity:0.9;font-weight:400;border:none;background:none;width:calc(100% - 12px);text-align:left;font-family:var(--font);text-decoration:none}
.nav:hover, a.nav:hover{background-color:rgba(35, 209, 139, 0.9) !important;color:#000000 !important;opacity:1 !important}
.nav.active, a.nav.active{background-color:rgba(35, 209, 139, 0.15) !important;color:var(--green) !important;opacity:1 !important}
/* Destacar permanentemente el Dashboard — acceso rápido más visible */
#nav-dashboard{background-color:rgba(79,142,247,0.18) !important;border:1px solid rgba(79,142,247,0.35) !important;opacity:1 !important;font-weight:500 !important}
#nav-dashboard:hover{background-color:rgba(79,142,247,0.28) !important}
#nav-dashboard.active{background-color:rgba(79,142,247,0.32) !important;color:#7eb2ff !important;border-color:rgba(79,142,247,0.6) !important}

.nav .ni{width:15px;text-align:center;font-size:13px;flex-shrink:0}
.nb{margin-left:auto;font-size:10px;padding:3px 7px;border-radius:11px;font-weight:800!important;color:#000!important;min-width:20px;text-align:center;line-height:1.2}
.nb-blue{background:var(--accent)}
.nb-red{background:var(--red)}
.nb-amber{background:var(--amber);color:#000!important;font-weight:800!important}
.nb-green{background:var(--green);color:#000!important;font-weight:800!important}
.nb-purple{background:var(--purple)}
.nb-new{background:linear-gradient(90deg,var(--purple),var(--accent));font-size:9px;padding:3px 6px;color:#000!important;font-weight:800!important}
/* ── Alert filter counter badges ── */
.afc-badge{display:inline-flex;align-items:center;justify-content:center;min-width:17px;height:17px;padding:0 4px;border-radius:8px;font-size:9px;font-weight:700;background:rgba(0,0,0,0.15);color:inherit;margin-left:3px;vertical-align:middle}
.btn-primary .afc-badge{background:rgba(255,255,255,0.25);color:#fff}
#alerts-filter-bar .btn.af-active{background:var(--accent)!important;color:#fff!important;border-color:var(--accent)!important}

/* ── MAIN ── */
#main{margin-left:var(--sidebar);flex:1;display:flex;flex-direction:column;min-height:100vh}
.topbar{background:var(--bg2);border-bottom:1px solid var(--border);padding:0 24px;height:54px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50}
.topbar-l{display:flex;align-items:center;gap:10px}
.page-title{font-size:15px;font-weight:500}
.page-sub{font-size:11px;color:var(--text3)}
.topbar-r{display:flex;align-items:center;gap:8px}
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:var(--rs);font-size:12.5px;font-weight:500;cursor:pointer;border:none;transition:all .14s;font-family:var(--font)}
.btn-primary{background:var(--accent);color:#fff}.btn-primary:hover{background:#3672e0}
.btn-ghost{background:var(--bg3);color:var(--text2);border:1px solid var(--border2)}.btn-ghost:hover{background:var(--bg4);color:var(--text)}
.btn-danger{background:var(--red-g);color:var(--red);border:1px solid rgba(244,100,95,0.2)}.btn-danger:hover{background:rgba(244,100,95,0.2)}
.btn-success{background:var(--green-g);color:var(--green);border:1px solid rgba(35,209,139,0.2)}
.btn-sm{padding:5px 10px;font-size:11.5px}
.btn-xs{padding:3px 8px;font-size:11px}

/* ── CONTENT ── */
.content{padding:22px;flex:1;min-width:0;overflow-x:hidden}
.section{display:none}
.section.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.fade-in{animation:fadeUp .25s ease both}

/* ── METRIC CARDS ── */
.mgt{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.mgt-3{grid-template-columns:repeat(3,1fr)}
.mgt-5{grid-template-columns:repeat(5,1fr)}
.mc{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:16px 18px;position:relative;overflow:hidden;transition:border-color .2s}
.mc:hover{border-color:var(--border2)}
.mc::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;border-radius:2px 2px 0 0}
.mc.c-blue::after{background:var(--accent)}.mc.c-green::after{background:var(--green)}
.mc.c-amber::after{background:var(--amber)}.mc.c-purple::after{background:var(--purple)}
.mc.c-teal::after{background:var(--teal)}.mc.c-red::after{background:var(--red)}
.mc.c-pink::after{background:var(--pink)}
.mc-label{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.07em;font-weight:700;margin-bottom:7px}
.mc-val{font-size:24px;font-weight:600;color:var(--text);line-height:1;font-variant-numeric:tabular-nums}
.mc-sub{font-size:11px;color:var(--text2);margin-top:5px;display:flex;align-items:center;gap:5px}
.delta{font-size:10px;font-weight:700;padding:2px 5px;border-radius:4px}
.up{background:var(--green-g);color:var(--green)}.down{background:var(--red-g);color:var(--red)}
.flat{background:var(--bg4);color:var(--text3)}
